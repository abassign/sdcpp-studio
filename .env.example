# ---------------------------------------------------------------------------
# sdcpp-studio - environment (copy to .env and edit)
# ---------------------------------------------------------------------------
# Data directories. By default the launcher is "context aware": if ../models
# ./outputs exist they are reused, otherwise the package folders are used.
# Override here for an explicit layout (e.g. shared data next to the project).

# MODELS_DIR=/run/media/abassign/AI2/docker/models
# OUTPUTS_DIR=/run/media/abassign/AI2/docker/outputs
# HF_CACHE_DIR=/run/media/abassign/AI2/docker/hf_cache

# Web UI port
PORT=8000

# GPU selection (ROCm / CUDA / CPU). Leave empty for auto-detect.
GPU_TYPE=

# Hugging Face / Civitai tokens (optional; needed for gated models)
HF_TOKEN=
CIVITAI_TOKEN=
